        <!-- Area Simulation Sliders -->
        <div class="bg-slate-900/70 p-4 rounded-xl border border-slate-800 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <div>
            <label class="flex justify-between text-slate-300 font-medium mb-1">
