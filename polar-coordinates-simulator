    function renderCurveSliders(sliders) {
      const container = document.getElementById('curve-sliders-container');
      if (!container) return;
      container.innerHTML = '';
      if (!sliders || sliders.length === 0) return;
      
      sliders.forEach(s => {
        const div = document.createElement('div');
        div.className = 'flex items-center gap-2 text-xs text-slate-300';
        div.innerHTML = `
          <span class="font-medium whitespace-nowrap">${s.label}:</span>
          <input type="range" min="${s.min}" max="${s.max}" step="${s.step}" value="${curveState.params[s.id] ?? s.val}" class="w-24">
          <span class="font-mono text-cyan-300 w-8 text-right">${curveState.params[s.id] ?? s.val}</span>
        `;
        const input = div.querySelector('input');
        const valDisplay = div.querySelector('span:last-child');
        input.addEventListener('input', (e) => {
          const v = parseFloat(e.target.value);
          curveState.params[s.id] = v;
          valDisplay.textContent = v;
          drawCurvesCanvas();
        });
        container.appendChild(div);
      });
    }

