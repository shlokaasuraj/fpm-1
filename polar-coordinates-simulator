    function animateCurveLoop() {
      if (!curveState.isAnimating) return;
      curveState.sweepTheta += 0.035;
      if (curveState.sweepTheta > 2 * Math.PI) {
        curveState.sweepTheta = 2 * Math.PI;
        curveState.isAnimating = false;
        const icon = document.getElementById('curve-play-icon');
        const text = document.getElementById('curve-play-text');
        if (icon) icon.textContent = '▶';
        if (text) text.textContent = 'Sweep Trace';
      }
      if (sliderCurveSweep) sliderCurveSweep.value = curveState.sweepTheta.toFixed(2);
      if (valCurveSweep) valCurveSweep.textContent = `${(curveState.sweepTheta / Math.PI).toFixed(2)}π`;
      drawCurvesCanvas();
      if (curveState.isAnimating) {
        curveState.animId = requestAnimationFrame(animateCurveLoop);
      }
    }

    if (sliderCurveSweep) {
      sliderCurveSweep.addEventListener('input', (e) => {
        curveState.sweepTheta = parseFloat(e.target.value);
        if (valCurveSweep) valCurveSweep.textContent = `${(curveState.sweepTheta / Math.PI).toFixed(2)}π`;
        drawCurvesCanvas();
      });
    }

    function drawCurvesCanvas() {
      if (!canvasCurves) return;
      const { ctx, width, height } = setupHiDPICanvas(canvasCurves);
      if (!ctx) return;
      const originX = width / 2;
      const originY = height / 2;
      const s = curveState.scale;

      ctx.clearRect(0, 0, width, height);

      // Radar rings
      for (let rad = 1; rad <= 5; rad++) {
        ctx.beginPath();
        ctx.arc(originX, originY, rad * s, 0, 2 * Math.PI);
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.1)';
        ctx.stroke();
      }

      // Axes
      ctx.beginPath();
      ctx.moveTo(0, originY); ctx.lineTo(width, originY);
      ctx.moveTo(originX, 0); ctx.lineTo(originX, height);
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.4)';
      ctx.stroke();

      const info = curveLibrary[curveState.preset];
      if (!info) return;

      const maxTheta = curveState.sweepTheta;
      const steps = 600;
      const dTh = (2 * Math.PI) / steps;

      // Faint full curve preview
      ctx.save();
      ctx.beginPath();
      let first = true;
      for (let th = 0; th <= 2 * Math.PI + 0.01; th += dTh) {
        const r = info.equation(th, curveState.params);
        if (r >= 0) {
          const px = originX + r * Math.cos(th) * s;
          const py = originY - r * Math.sin(th) * s;
          if (first) { ctx.moveTo(px, py); first = false; }
          else { ctx.lineTo(px, py); }
        } else {
          first = true;
        }
      }
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.15)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.restore();

      // Active painted curve
      ctx.save();
      let currentBeamPos = null;

      // 1. Valid r >= 0 solid glowing line
      ctx.beginPath();
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 3;
      ctx.shadowColor = '#38bdf8';
      ctx.shadowBlur = 12;

      let drawingPositive = false;
      for (let th = 0; th <= maxTheta + 0.001; th += 0.01) {
        const r = info.equation(th, curveState.params);
        if (r >= 0) {
          const px = originX + r * Math.cos(th) * s;
          const py = originY - r * Math.sin(th) * s;
          currentBeamPos = { x: px, y: py, r, th };
          if (!drawingPositive) {
            ctx.moveTo(px, py);
            drawingPositive = true;
          } else {
            ctx.lineTo(px, py);
          }
        } else {
          drawingPositive = false;
        }
      }
      ctx.stroke();
      ctx.shadowBlur = 0;

      // 2. Negative r (dashed ghost path)
      ctx.beginPath();
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = 'rgba(244, 63, 94, 0.6)';
      ctx.lineWidth = 1.5;
      let drawingNegative = false;
      for (let th = 0; th <= maxTheta + 0.001; th += 0.01) {
        const r = info.equation(th, curveState.params);
        if (r < 0) {
          const px = originX + Math.abs(r) * Math.cos(th + Math.PI) * s;
          const py = originY - Math.abs(r) * Math.sin(th + Math.PI) * s;
          if (!drawingNegative) {
            ctx.moveTo(px, py);
            drawingNegative = true;
          } else {
            ctx.lineTo(px, py);
          }
        } else {
          drawingNegative = false;
        }
      }
      ctx.stroke();
      ctx.restore();

      // Flashlight beam
      if (maxTheta < 2 * Math.PI) {
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(originX, originY);
        const beamEndTh = maxTheta;
        const beamLen = 5.2 * s;
        ctx.lineTo(originX + Math.cos(beamEndTh) * beamLen, originY - Math.sin(beamEndTh) * beamLen);
        ctx.strokeStyle = 'rgba(52, 211, 153, 0.6)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([2, 2]);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(originX, originY);
        ctx.arc(originX, originY, beamLen, -beamEndTh, -beamEndTh + 0.08);
        ctx.fillStyle = 'rgba(52, 211, 153, 0.06)';
        ctx.fill();
        ctx.restore();
      }

      // Painting pen tip
      if (currentBeamPos) {
        ctx.beginPath();
        ctx.arc(currentBeamPos.x, currentBeamPos.y, 6, 0, 2 * Math.PI);
        ctx.fillStyle = '#22c55e';
        ctx.shadowColor = '#22c55e';
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();
      }
    }

    const canvasArea = document.getElementById('canvas-area');
    const sliderAreaWedges = document.getElementById('slider-area-wedges');
    const sliderAreaAlpha = document.getElementById('slider-area-alpha');
    const sliderAreaBeta = document.getElementById('slider-area-beta');

    let areaState = {
      curveType: 'cardioid',
      wedges: 16,
      alpha: 0,
      beta: Math.PI,
      scale: 65
    };

    sliderAreaWedges.addEventListener('input', (e) => {
      areaState.wedges = parseInt(e.target.value);
      document.getElementById('val-wedges').textContent = areaState.wedges;
      drawAreaCanvas();
    });

    sliderAreaAlpha.addEventListener('input', (e) => {
      areaState.alpha = parseFloat(e.target.value);
      document.getElementById('val-alpha').textContent = `${areaState.alpha.toFixed(2)} (${(areaState.alpha*180/Math.PI).toFixed(0)}°)`;
      drawAreaCanvas();
    });

    sliderAreaBeta.addEventListener('input', (e) => {
      areaState.beta = parseFloat(e.target.value);
      document.getElementById('val-beta').textContent = `${areaState.beta.toFixed(2)} (${(areaState.beta*180/Math.PI).toFixed(0)}°)`;
      drawAreaCanvas();
    });

    function setAreaCase(type) {
      if (type === 'cardioid-half') {
        areaState.curveType = 'cardioid';
        areaState.alpha = 0;
        areaState.beta = Math.PI;
        areaState.wedges = 20;
      } else if (type === 'rose-petal') {
        areaState.curveType = 'rose2';
        areaState.alpha = -Math.PI / 4;
        areaState.beta = Math.PI / 4;
        areaState.wedges = 24;
      } else if (type === 'archimedes-quad') {
        areaState.curveType = 'spiral';
        areaState.alpha = 0;
        areaState.beta = Math.PI / 2;
        areaState.wedges = 18;
      } else if (type === 'two-circles') {
        areaState.curveType = 'two-circles';
        areaState.alpha = 0;
        areaState.beta = Math.PI / 2;
        areaState.wedges = 32;
      }

      sliderAreaAlpha.value = areaState.alpha;
      sliderAreaBeta.value = areaState.beta;
      sliderAreaWedges.value = areaState.wedges;
      document.getElementById('val-wedges').textContent = areaState.wedges;
      document.getElementById('val-alpha').textContent = `${areaState.alpha.toFixed(2)} (${(areaState.alpha*180/Math.PI).toFixed(0)}°)`;
      document.getElementById('val-beta').textContent = `${areaState.beta.toFixed(2)} (${(areaState.beta*180/Math.PI).toFixed(0)}°)`;
      drawAreaCanvas();
    }

    function getAreaRadius(type, th) {
      if (type === 'cardioid') return 1.0 + Math.cos(th);
      if (type === 'rose2') return Math.max(0, Math.cos(2 * th));
      if (type === 'spiral') return th;
      if (type === 'two-circles') {
        return Math.min(Math.sin(th), Math.cos(th));
      }
      return 1.0;
    }

    function drawAreaCanvas() {
      if (!canvasArea) return;
      const { ctx, width, height } = setupHiDPICanvas(canvasArea);
      if (!ctx) return;
      const originX = width / 2;
      const originY = height / 2;
      const s = areaState.scale;

      ctx.clearRect(0, 0, width, height);

      // Rings
      for (let rad = 1; rad <= 4; rad++) {
        ctx.beginPath();
        ctx.arc(originX, originY, rad * s, 0, 2 * Math.PI);
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.1)';
        ctx.stroke();
      }

      // Axes
      ctx.beginPath();
      ctx.moveTo(0, originY); ctx.lineTo(width, originY);
      ctx.moveTo(originX, 0); ctx.lineTo(originX, height);
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.4)';
      ctx.stroke();

      const alpha = Math.min(areaState.alpha, areaState.beta);
      const beta = Math.max(areaState.alpha, areaState.beta);
      const N = areaState.wedges;
      const dTh = (beta - alpha) / N;

      let riemannSum = 0;

      // Slices
      ctx.save();
      for (let i = 0; i < N; i++) {
        const th1 = alpha + i * dTh;
        const th2 = th1 + dTh;
        const thMid = (th1 + th2) / 2;
        const rMid = getAreaRadius(areaState.curveType, thMid);

        const sliceArea = 0.5 * rMid * rMid * dTh;
        riemannSum += sliceArea;

        ctx.beginPath();
        ctx.moveTo(originX, originY);
        ctx.arc(originX, originY, rMid * s, -th1, -th2, true);
        ctx.closePath();

        ctx.fillStyle = i % 2 === 0 ? 'rgba(245, 158, 11, 0.45)' : 'rgba(251, 191, 36, 0.35)';
        ctx.fill();

        ctx.strokeStyle = 'rgba(254, 243, 199, 0.7)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      ctx.restore();

      // Full curve outline
      ctx.save();
      ctx.beginPath();
      let hasBegun = false;
      for (let th = 0; th <= 2 * Math.PI + 0.02; th += 0.02) {
        const r = getAreaRadius(areaState.curveType, th);
        if (r >= 0) {
          const px = originX + r * Math.cos(th) * s;
          const py = originY - r * Math.sin(th) * s;
          if (!hasBegun) { ctx.moveTo(px, py); hasBegun = true; }
          else { ctx.lineTo(px, py); }
        }
      }
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      const drawRay = (ang, label, color) => {
        ctx.beginPath();
        ctx.moveTo(originX, originY);
        ctx.lineTo(originX + Math.cos(ang) * 4.5 * s, originY - Math.sin(ang) * 4.5 * s);
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 4]);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.fillStyle = color;
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(label, originX + Math.cos(ang) * 4.6 * s, originY - Math.sin(ang) * 4.6 * s);
      };

      drawRay(alpha, 'θ = α', '#34d399');
      drawRay(beta, 'θ = β', '#f43f5e');

      ctx.restore();

      // Theoretical area
      let exactFormula = '';
      if (areaState.curveType === 'cardioid' && Math.abs(alpha - 0) < 0.05 && Math.abs(beta - Math.PI) < 0.05) {
        exactFormula = '3π/4 ≈ 2.356';
      } else if (areaState.curveType === 'rose2' && Math.abs(alpha - (-Math.PI/4)) < 0.05 && Math.abs(beta - Math.PI/4) < 0.05) {
        exactFormula = 'π/8 ≈ 0.393';
      } else if (areaState.curveType === 'spiral') {
        const exact = (beta * beta * beta - alpha * alpha * alpha) / 6;
        exactFormula = `${exact.toFixed(3)}`;
      } else {
        let fineSum = 0;
        const sub = 2000;
        const dt = (beta - alpha) / sub;
        for (let j = 0; j < sub; j++) {
          const t = alpha + (j + 0.5) * dt;
          const r = getAreaRadius(areaState.curveType, t);
          fineSum += 0.5 * r * r * dt;
        }
        exactFormula = `${fineSum.toFixed(3)}`;
      }

      document.getElementById('stat-wedges-count').textContent = `N = ${N}`;
      document.getElementById('stat-riemann-area').textContent = `≈ ${riemannSum.toFixed(3)}`;
      document.getElementById('stat-exact-area').textContent = exactFormula;
    }

    const canvasCalculus = document.getElementById('canvas-calculus');
    const sliderCalcTheta = document.getElementById('slider-calc-theta');

    let calcState = {
      curve: 'cardioid',
      theta: Math.PI / 3,
      scale: 75
    };

    sliderCalcTheta.addEventListener('input', (e) => {
      calcState.theta = parseFloat(e.target.value);
      drawCalculusCanvas();
    });

    function setCalculusCurve(key) {
      calcState.curve = key;
      document.querySelectorAll('.calc-curve-btn').forEach(btn => {
        btn.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
        btn.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      });
      const active = document.getElementById('btn-calc-' + key);
      if (active) {
        active.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
        active.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      }

      if (key === 'cardioid') calcState.theta = Math.PI / 3;
      if (key === 'rose2') calcState.theta = 0.615;
      if (key === 'spiral-decay') calcState.theta = 1.0;

      sliderCalcTheta.value = calcState.theta.toFixed(2);
      drawCalculusCanvas();
    }

    function evaluateCalcFunctions(curve, th) {
      let r, dr, x, y, dx, dy;
      if (curve === 'cardioid') {
        r = 1 + Math.cos(th);
        dr = -Math.sin(th);
        x = r * Math.cos(th);
        y = r * Math.sin(th);
        dx = -Math.sin(th) - Math.sin(2 * th);
        dy = Math.cos(th) + Math.cos(2 * th);
      } else if (curve === 'rose2') {
        r = Math.sin(2 * th);
        dr = 2 * Math.cos(2 * th);
        x = r * Math.cos(th);
        y = r * Math.sin(th);
        dx = 2 * Math.cos(2 * th) * Math.cos(th) - Math.sin(2 * th) * Math.sin(th);
        dy = 2 * Math.cos(2 * th) * Math.sin(th) + Math.sin(2 * th) * Math.cos(th);
      } else {
        r = th * Math.exp(-th);
        dr = Math.exp(-th) * (1 - th);
        x = r * Math.cos(th);
        y = r * Math.sin(th);
        dx = dr * Math.cos(th) - r * Math.sin(th);
        dy = dr * Math.sin(th) + r * Math.cos(th);
      }
      return { r, dr, x, y, dx, dy };
    }

    function drawCalculusCanvas() {
      if (!canvasCalculus) return;
      const { ctx, width, height } = setupHiDPICanvas(canvasCalculus);
      if (!ctx) return;
      const originX = width / 2;
      const originY = height / 2;
      const s = calcState.scale;

      ctx.clearRect(0, 0, width, height);

      // Axes
      ctx.beginPath();
      ctx.moveTo(0, originY); ctx.lineTo(width, originY);
      ctx.moveTo(originX, 0); ctx.lineTo(originX, height);
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.3)';
      ctx.stroke();

      const th = calcState.theta;
      const { r, dr, x, y, dx, dy } = evaluateCalcFunctions(calcState.curve, th);

      // Curve path
      ctx.save();
      ctx.beginPath();
      let first = true;
      for (let t = 0; t <= 2 * Math.PI + 0.02; t += 0.02) {
        const val = evaluateCalcFunctions(calcState.curve, t);
        if (val.r >= 0) {
          const px = originX + val.x * s;
          const py = originY - val.y * s;
          if (first) { ctx.moveTo(px, py); first = false; }
          else { ctx.lineTo(px, py); }
        }
      }
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.restore();

      const ptX = originX + x * s;
      const ptY = originY - y * s;

      // Radial ray
      ctx.beginPath();
      ctx.moveTo(originX, originY);
      ctx.lineTo(ptX, ptY);
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.6)';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Tangent vector
      const tangentLen = 120;
      const mag = Math.sqrt(dx * dx + dy * dy) || 1;
      const ux = dx / mag;
      const uy = -dy / mag;

      ctx.save();
      ctx.beginPath();
      ctx.moveTo(ptX - ux * tangentLen, ptY - uy * tangentLen);
      ctx.lineTo(ptX + ux * tangentLen, ptY + uy * tangentLen);
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 2.5;
      ctx.shadowColor = '#f59e0b';
      ctx.shadowBlur = 8;
      ctx.stroke();
      ctx.restore();

      // Normal line
      ctx.beginPath();
      ctx.moveTo(ptX - (-uy) * 40, ptY - (ux) * 40);
      ctx.lineTo(ptX + (-uy) * 40, ptY + (ux) * 40);
      ctx.strokeStyle = 'rgba(236, 72, 153, 0.4)';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Probe Point
      ctx.beginPath();
      ctx.arc(ptX, ptY, 7, 0, 2 * Math.PI);
      ctx.fillStyle = Math.abs(dy) < 0.05 ? '#10b981' : (Math.abs(dx) < 0.05 ? '#f43f5e' : '#38bdf8');
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();

      document.getElementById('calc-probe-theta').textContent = `θ = ${th.toFixed(2)} rad (${(th*180/Math.PI).toFixed(0)}°)`;
      document.getElementById('calc-dr-dtheta').textContent = `dr/dθ = ${dr.toFixed(3)}`;
      document.getElementById('calc-dy-dtheta').textContent = `dy/dθ = ${dy.toFixed(3)} ${Math.abs(dy) < 0.08 ? '🎯 (Peak!)' : ''}`;

      renderCalculusStepCard(calcState.curve, th, r, dr, x, y, dx, dy);
    }

    function renderCalculusStepCard(curve, th, r, dr, x, y, dx, dy) {
      const card = document.getElementById('calc-step-card');
      if (!card) return;
      if (appMode === 'eli6') {
        if (curve === 'cardioid') {
          card.innerHTML = `
            <div class="font-bold text-emerald-300">🎈 The Highest Balloon Ceiling (ELI6)</div>
            <p class="text-slate-300">
              Imagine releasing a helium balloon inside this heart! Where does it stop on the ceiling?<br>
              • Balloon height is simply $y = r\\sin\\theta$.<br>
              • The highest flat rooftop point is where the slope stops going up and starts going down (that means $\\frac{dy}{d\\theta} = 0$).<br>
              • This happens when you turn exactly 60° ($\\theta = \\frac{\\pi}{3}$)! Maximum height is about <strong>1.30 steps high</strong>!
            </p>
          `;
        } else if (curve === 'rose2') {
          card.innerHTML = `
            <div class="font-bold text-emerald-300">🏎️ The Furthest Right Turn (ELI6)</div>
            <p class="text-slate-300">
              Imagine driving a toy race car around the flower petal! Where do you bump into the wall on the far right?<br>
              • Right-distance is $x = r\\cos\\theta$.<br>
              • You reach the furthest east wall when $\\frac{dx}{d\\theta} = 0$, which gives a completely vertical tangent line!<br>
              • Turn your flashlight to about 35.3° and you hit the furthest wall ($x \\approx 0.77$).
            </p>
          `;
        } else {
          card.innerHTML = `
            <div class="font-bold text-emerald-300">📏 The Stretchiest Rubber Arm (ELI6)</div>
            <p class="text-slate-300">
              • Here we just want the arm length $r$ to be as big as possible from the center base! So $\\frac{dr}{d\\theta} = 0$.<br>
              • When your arm stretches furthest, the tip of the curve is perpendicular (a 90° angle) to your arm!
            </p>
          `;
        }
      } else {
        if (curve === 'cardioid') {
          card.innerHTML = `
            <div class="font-bold text-cyan-300">Worked Ex 5.11: Stationary Points of y for $r = 1 + \\cos\\theta$</div>
            <div class="text-slate-300 space-y-1">
              <div><strong class="text-amber-400">[M1]</strong> Parametric height: $y = r\\sin\\theta = (1 + \\cos\\theta)\\sin\\theta = \\sin\\theta + \\frac{1}{2}\\sin 2\\theta$</div>
              <div><strong class="text-amber-400">[M1]</strong> Differentiate w.r.t $\\theta$: $\\frac{dy}{d\\theta} = \\cos\\theta + \\cos 2\\theta = 2\\cos^2\\theta + \\cos\\theta - 1$</div>
              <div><strong class="text-amber-400">[M1]</strong> Stationary condition $\\frac{dy}{d\\theta} = 0$: $(2\\cos\\theta - 1)(\\cos\\theta + 1) = 0$</div>
              <div><strong class="text-emerald-400">[A1]</strong> In $[0, \\pi]$, $\\cos\\theta = \\frac{1}{2} \\implies \\theta = \\frac{\\pi}{3}$. Max height $y_{\\max} = \\frac{3\\sqrt{3}}{4} \\approx 1.299$.</div>
              <div class="text-[11px] text-slate-400 italic">Note: $\\cos\\theta = -1 \\implies \\theta = \\pi$ corresponds to the cusp at the origin ($y=0$).</div>
            </div>
          `;
        } else if (curve === 'rose2') {
          card.innerHTML = `
            <div class="font-bold text-cyan-300">Page 112: Maximising Horizontal Coordinate $x$ for $r = \\sin(2\\theta)$</div>
            <div class="text-slate-300 space-y-1">
              <div><strong class="text-amber-400">[M1]</strong> Coordinate: $x = r\\cos\\theta = \\sin 2\\theta \\cos\\theta$</div>
              <div><strong class="text-amber-400">[M1]</strong> Product Rule: $\\frac{dx}{d\\theta} = 2\\cos 2\\theta \\cos\\theta - \\sin 2\\theta \\sin\\theta = 2\\cos\\theta(3\\cos^2\\theta - 2) = 0$</div>
              <div><strong class="text-emerald-400">[A1]</strong> Discard $\\cos\\theta = 0$ (pole entry). Valid root $\\cos^2\\theta = \\frac{2}{3} \\implies \\cos\\theta = \\sqrt{2/3}$ ($\\theta \\approx 0.615$ rad).</div>
              <div><strong class="text-emerald-400">[A1]</strong> Maximum displacement: $x_{\\max} = 2(\\frac{1}{\\sqrt{3}})(\\sqrt{2/3})^2 = \\frac{4\\sqrt{3}}{9} \\approx 0.770$.</div>
            </div>
          `;
        } else {
          card.innerHTML = `
            <div class="font-bold text-cyan-300">Worked Ex 5.10: Maximum Distance from Origin for $r = \\theta e^{-\\theta}$</div>
            <div class="text-slate-300 space-y-1">
              <div><strong class="text-amber-400">[M1]</strong> Radial extremum requires $\\frac{dr}{d\\theta} = 0$.</div>
              <div><strong class="text-amber-400">[M1]</strong> Product rule: $\\frac{dr}{d\\theta} = e^{-\\theta} - \\theta e^{-\\theta} = e^{-\\theta}(1 - \\theta) = 0$</div>
              <div><strong class="text-emerald-400">[A1]</strong> Since $e^{-\\theta} \\neq 0$, unique stationary point at $\\theta = 1$ radian ($57.3°$).</div>
              <div><strong class="text-emerald-400">[A1]</strong> Maximum distance: $r_{\\max} = 1 \\cdot e^{-1} = \\frac{1}{e} \\approx 0.368$. Tangent at this point is strictly normal to radius vector.</div>
            </div>
          `;
        }
      }
      renderMath(card);
    }

    function loadChallengePreset(type) {
      if (type === 'circle-sin') {
        switchTab('tab-curves');
        selectCurvePreset('circle-offset');
      } else if (type === 'split-area') {
        switchTab('tab-area');
        setAreaCase('two-circles');
      } else if (type === 'past-paper-2009') {
        switchTab('tab-area');
        setAreaCase('archimedes-quad');
      }
    }

    function checkQuiz(qNum, choice) {
      const feedback = document.getElementById(`q${qNum}-feedback`);
      feedback.classList.remove('hidden', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40', 'bg-red-500/20', 'text-red-300', 'border-red-500/40');

      if (qNum === 1) {
        if (choice === 'B') {
          feedback.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/40');
          feedback.innerHTML = '🎉 <strong>Spot on!</strong> For $r = \\sin(k\\theta)$, when $k$ is odd (like 3), the negative parts re-trace the same loops or are excluded under $r \\ge 0$, giving exactly $k = 3$ petals! If $k$ is even, you get $2k$ petals!';
        } else {
          feedback.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/40');
          feedback.innerHTML = '❌ <strong>Not quite!</strong> Remember the odd/even rule: odd $k$ creates $k$ petals. Even $k$ (like $\\cos 2\\theta$) creates $2k = 4$ petals!';
        }
      } else if (qNum === 2) {
        if (choice === 'C') {
          feedback.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/40');
          feedback.innerHTML = '🎉 <strong>Correct!</strong> Height is the $y$-coordinate, which is $y = r\\sin\\theta$. The highest point off the floor requires $\\frac{dy}{d\\theta} = 0$!';
        } else {
          feedback.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/40');
          feedback.innerHTML = '❌ <strong>Careful!</strong> $dr/d\\theta = 0$ gives the furthest distance from the origin (stretchiest arm), but NOT necessarily the highest off the horizontal ground!';
        }
      }
      renderMath(feedback);
    }

    window.addEventListener('resize', () => {
      if (currentTab === 'tab-basics') drawBasicsCanvas();
      if (currentTab === 'tab-curves') drawCurvesCanvas();
      if (currentTab === 'tab-area') drawAreaCanvas();
      if (currentTab === 'tab-calculus') drawCalculusCanvas();
    });

    window.onload = function() {
      setAppMode('eli6');
      switchTab('tab-basics');
      selectCurvePreset('cardioid');
      setAreaCase('cardioid-half');
      setCalculusCurve('cardioid');
      renderMath(document.body);
    };
  </script>
</body>
