    function snapCurrentBasicsPoint() {
      if (!snapEnabled) return;
      let bestTheta = basicsState.theta;
      let minDiff = Infinity;
      let matchedAngle = null;

      for (let item of SPECIAL_ANGLES) {
        let diff = Math.abs(basicsState.theta - item.rad);
        if (diff < minDiff) {
          minDiff = diff;
          bestTheta = item.rad;
          matchedAngle = item;
        }
      }
      basicsState.theta = bestTheta;
      basicsState.snappedAngleObj = matchedAngle;
      basicsState.r = Math.round(basicsState.r * 2) / 2;
      if (basicsState.r < 0.5) basicsState.r = 0.5;

