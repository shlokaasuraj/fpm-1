              Polar Explorer: Cambridge 9231 FP1
            </h1>
            <div class="inline-flex p-0.5 rounded-lg bg-slate-950 border border-slate-800 text-[11px] font-semibold">
              <button id="btn-mode-eli6" onclick="setAppMode('eli6')" class="px-2.5 py-0.5 rounded-md transition bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
                <span>👶</span> ELI6 Mode
              </button>
              <button id="btn-mode-exam" onclick="setAppMode('exam')" class="px-2.5 py-0.5 rounded-md transition text-slate-400 hover:text-slate-200 flex items-center gap-1">
                <span>🎓</span> Exam 9231 Mode
              </button>
            </div>
          </div>
          <p id="header-subtitle" class="text-xs text-slate-400">Mastering Distance ($r$), Angle ($\theta$), Sector Areas & Derivatives</p>
        </div>
      </div>

      <!-- Mode Selector Tabs -->
      <nav class="flex items-center bg-slate-950/80 p-1 rounded-xl border border-slate-800 text-xs sm:text-sm">
        <button onclick="switchTab('tab-basics')" id="btn-tab-basics" class="tab-btn px-3 py-1.5 rounded-lg font-medium transition-all bg-cyan-500 text-slate-950 shadow-md">
