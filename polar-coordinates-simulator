  <!-- Tailwind CSS for modern responsive styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- KaTeX for mathematical formulas -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
