    function toggleCurvePlay() {
      curveState.isAnimating = !curveState.isAnimating;
      const icon = document.getElementById('curve-play-icon');
      const text = document.getElementById('curve-play-text');
      if (curveState.isAnimating) {
        if (curveState.sweepTheta >= 2 * Math.PI - 0.05) {
          curveState.sweepTheta = 0;
        }
        if (icon) icon.textContent = '⏸';
        if (text) text.textContent = 'Pause';
        requestAnimationFrame(animateCurveLoop);
      } else {
        if (icon) icon.textContent = '▶';
        if (text) text.textContent = 'Sweep Trace';
      }
    }

    function resetCurveSweep() {
      curveState.isAnimating = false;
      curveState.sweepTheta = 2 * Math.PI;
      const icon = document.getElementById('curve-play-icon');
      const text = document.getElementById('curve-play-text');
      if (icon) icon.textContent = '▶';
      if (text) text.textContent = 'Sweep Trace';
      if (sliderCurveSweep) sliderCurveSweep.value = (2 * Math.PI).toFixed(2);
      if (valCurveSweep) valCurveSweep.textContent = '2.00π';
      drawCurvesCanvas();
