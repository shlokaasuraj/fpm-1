          </button>
          <button id="btn-preset-rose-3" onclick="selectCurvePreset('rose-3')" class="curve-preset-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 font-medium transition">
            🌸 3-Petal Rose
          </button>
          <button id="btn-preset-rose-2" onclick="selectCurvePreset('rose-2')" class="curve-preset-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 font-medium transition">
            🍀 4-Petal Clover
          </button>
          <button id="btn-preset-spiral-arch" onclick="selectCurvePreset('spiral-arch')" class="curve-preset-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 font-medium transition">
            🌀 Spiral ($r=a\theta$)
          </button>
          <button id="btn-preset-circle-offset" onclick="selectCurvePreset('circle-offset')" class="curve-preset-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 font-medium transition">
            ⚪ Circle ($r=2a\cos\theta$)
          </button>
          <button id="btn-preset-limacon-loop" onclick="selectCurvePreset('limacon-loop')" class="curve-preset-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 font-medium transition">
            🎀 Limaçon Loop
          </button>
        </div>

        <!-- Controls: Sweep animation & parameters -->
        <div class="bg-slate-900/70 p-4 rounded-xl border border-slate-800 flex flex-col sm:flex-row gap-4 justify-between items-center text-xs">
