            </button>
            <button id="btn-toggle-snap" onclick="toggleCoordinateSnap()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-200 border border-slate-700 transition flex items-center gap-1.5">
