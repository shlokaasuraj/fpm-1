    <!-- TAB 3: PIZZA SLICE AREA -->
    <section id="tab-area" class="tab-panel hidden flex flex-col lg:flex-row gap-6">
      <div class="lg:w-7/12 flex flex-col gap-3">
        <div class="relative rounded-2xl border border-slate-800 overflow-hidden shadow-2xl radar-canvas-bg">
