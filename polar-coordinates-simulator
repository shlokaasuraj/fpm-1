    function resetBasicsPoint() {
      basicsState.r = 3.0;
      basicsState.theta = 0.927;
      basicsState.snappedAngleObj = null;
      sliderBasicsR.value = 3.0;
      sliderBasicsTheta.value = 0.927;
      if (snapEnabled) snapCurrentBasicsPoint();
      else drawBasicsCanvas();
    }

    sliderBasicsTheta.addEventListener('input', (e) => {
      basicsState.theta = parseFloat(e.target.value);
      if (snapEnabled) snapCurrentBasicsPoint();
      else drawBasicsCanvas();
    });

    sliderBasicsR.addEventListener('input', (e) => {
      basicsState.r = parseFloat(e.target.value);
      if (snapEnabled) snapCurrentBasicsPoint();
      else drawBasicsCanvas();
    });

    function handleBasicsPointer(e) {
      const rect = canvasBasics.getBoundingClientRect();
      const originX = rect.width / 2;
      const originY = rect.height / 2;
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      const dx = (mouseX - originX) / basicsState.scale;
      const dy = -(mouseY - originY) / basicsState.scale;

      let r = Math.sqrt(dx * dx + dy * dy);
      let theta = Math.atan2(dy, dx);
      if (theta < 0) theta += 2 * Math.PI;

      r = Math.max(0.1, Math.min(5.0, r));

      if (snapEnabled) {
        let matched = null;
        for (let item of SPECIAL_ANGLES) {
          if (Math.abs(theta - item.rad) < 0.12) {
            theta = item.rad;
            matched = item;
            break;
          }
        }
        basicsState.snappedAngleObj = matched;
        r = Math.round(r * 2) / 2;
        if (r < 0.5) r = 0.5;
      } else {
        basicsState.snappedAngleObj = null;
      }

      basicsState.r = r;
      basicsState.theta = theta;

      sliderBasicsR.value = r.toFixed(2);
      sliderBasicsTheta.value = theta.toFixed(2);
      drawBasicsCanvas();
    }

    canvasBasics.addEventListener('mousedown', (e) => {
      basicsState.isDragging = true;
      handleBasicsPointer(e);
    });
    window.addEventListener('mousemove', (e) => {
      if (basicsState.isDragging && currentTab === 'tab-basics') handleBasicsPointer(e);
    });
    window.addEventListener('mouseup', () => {
      basicsState.isDragging = false;
    });

    canvasBasics.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        basicsState.isDragging = true;
        handleBasicsPointer(e.touches[0]);
      }
    }, { passive: true });
    canvasBasics.addEventListener('touchmove', (e) => {
      if (basicsState.isDragging && e.touches.length === 1) {
        handleBasicsPointer(e.touches[0]);
      }
    }, { passive: true });
    canvasBasics.addEventListener('touchend', () => {
      basicsState.isDragging = false;
    });

    function drawBasicsCanvas() {
      if (!canvasBasics) return;
      const { ctx, width, height } = setupHiDPICanvas(canvasBasics);
      if (!ctx) return;
      const originX = width / 2;
      const originY = height / 2;
      const s = basicsState.scale;

      ctx.clearRect(0, 0, width, height);

      // 1. Draw Grid
      if (basicsState.showSpiderweb) {
        for (let rad = 1; rad <= 5; rad++) {
          ctx.beginPath();
          ctx.arc(originX, originY, rad * s, 0, 2 * Math.PI);
          ctx.strokeStyle = rad % 2 === 0 ? 'rgba(56, 189, 248, 0.25)' : 'rgba(56, 189, 248, 0.12)';
          ctx.lineWidth = 1;
          ctx.stroke();

          ctx.fillStyle = 'rgba(56, 189, 248, 0.4)';
          ctx.font = '10px Fira Code, monospace';
          ctx.fillText(`r=${rad}`, originX + rad * s + 3, originY - 4);
        }

        for (let k = 0; k < 12; k++) {
          const ang = (k * Math.PI) / 6;
          ctx.beginPath();
          ctx.moveTo(originX, originY);
          ctx.lineTo(originX + Math.cos(ang) * 5.2 * s, originY - Math.sin(ang) * 5.2 * s);
          ctx.strokeStyle = 'rgba(56, 189, 248, 0.1)';
          ctx.stroke();
        }
      } else {
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.12)';
        ctx.lineWidth = 1;
        for (let x = -5; x <= 5; x++) {
          ctx.beginPath();
          ctx.moveTo(originX + x * s, 0);
          ctx.lineTo(originX + x * s, height);
          ctx.stroke();
        }
        for (let y = -5; y <= 5; y++) {
          ctx.beginPath();
          ctx.moveTo(0, originY - y * s);
          ctx.lineTo(width, originY - y * s);
          ctx.stroke();
        }
      }

      // 2. Coordinate Axes
      ctx.beginPath();
      ctx.moveTo(0, originY);
      ctx.lineTo(width, originY);
      ctx.moveTo(originX, 0);
      ctx.lineTo(originX, height);
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.5)';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#94a3b8';
      ctx.font = '11px sans-serif';
      ctx.fillText('Initial line (θ = 0 / x)', width - 140, originY - 8);
      ctx.fillText('θ = π/2 (y)', originX + 8, 20);
      ctx.fillText('Pole O', originX - 45, originY + 16);

      // 3. Compute Coordinates
      const r = basicsState.r;
      const th = basicsState.theta;
      const px = r * Math.cos(th);
      const py = r * Math.sin(th);
      const canvasPx = originX + px * s;
      const canvasPy = originY - py * s;

      // 4. Draw Triangle
      ctx.save();
      ctx.fillStyle = 'rgba(56, 189, 248, 0.08)';
      ctx.beginPath();
      ctx.moveTo(originX, originY);
      ctx.lineTo(canvasPx, originY);
      ctx.lineTo(canvasPx, canvasPy);
      ctx.closePath();
      ctx.fill();

      // Bottom x side
      ctx.beginPath();
      ctx.moveTo(originX, originY);
      ctx.lineTo(canvasPx, originY);
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Vertical y side
      ctx.beginPath();
      ctx.moveTo(canvasPx, originY);
      ctx.lineTo(canvasPx, canvasPy);
      ctx.strokeStyle = '#ec4899';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Hypotenuse r
      ctx.beginPath();
      ctx.moveTo(originX, originY);
      ctx.lineTo(canvasPx, canvasPy);
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 3;
      ctx.stroke();

      // Arc
      ctx.beginPath();
      ctx.arc(originX, originY, 32, 0, -th, th > Math.PI);
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      const midAngle = -th / 2;
      ctx.fillStyle = '#34d399';
      ctx.font = 'bold 12px Fredoka, sans-serif';
      ctx.fillText('θ', originX + Math.cos(midAngle) * 44 - 4, originY + Math.sin(midAngle) * 44 + 4);

      // Pole dot
      ctx.beginPath();
      ctx.arc(originX, originY, 5, 0, 2 * Math.PI);
      ctx.fillStyle = '#f8fafc';
      ctx.fill();

      if (snapEnabled && basicsState.snappedAngleObj) {
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(originX, originY);
        ctx.lineTo(originX + Math.cos(th) * 5.2 * s, originY - Math.sin(th) * 5.2 * s);
        ctx.strokeStyle = 'rgba(245, 158, 11, 0.4)';
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 4]);
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(canvasPx, canvasPy, 14, 0, 2 * Math.PI);
        ctx.strokeStyle = '#f59e0b';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.restore();
      }

      // Point P
      ctx.beginPath();
      ctx.arc(canvasPx, canvasPy, 8, 0, 2 * Math.PI);
      ctx.fillStyle = snapEnabled ? '#f59e0b' : '#38bdf8';
      ctx.shadowColor = snapEnabled ? '#f59e0b' : '#38bdf8';
      ctx.shadowBlur = 15;
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px Fira Code, monospace';
      const angleStr = (snapEnabled && basicsState.snappedAngleObj) 
        ? `${basicsState.snappedAngleObj.deg} [${basicsState.snappedAngleObj.label}]` 
        : `${(th*180/Math.PI).toFixed(0)}°`;
      ctx.fillText(`P (r=${r.toFixed(2)}, θ=${angleStr})`, canvasPx + 12, canvasPy - 10);

      ctx.restore();

      // Update HUD Labels
      document.getElementById('label-r').textContent = `r = ${r.toFixed(2)}`;
      document.getElementById('label-theta').textContent = (snapEnabled && basicsState.snappedAngleObj)
        ? `θ = ${basicsState.snappedAngleObj.label} (${basicsState.snappedAngleObj.deg})`
        : `θ = ${th.toFixed(2)} rad (${(th*180/Math.PI).toFixed(0)}°)`;
      document.getElementById('label-xy').textContent = `(${px.toFixed(2)}, ${py.toFixed(2)})`;
    }

    const canvasCurves = document.getElementById('canvas-curves');
    const sliderCurveSweep = document.getElementById('slider-curve-sweep');
    const valCurveSweep = document.getElementById('val-curve-sweep');

    let curveState = {
