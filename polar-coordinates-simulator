          </div>

          <!-- Touch/Drag Prompt Overlay -->
          <div class="absolute bottom-3 right-3 bg-slate-900/70 text-slate-300 text-[11px] px-2.5 py-1 rounded-lg border border-slate-700/50 pointer-events-none">
            🖱️ Click or drag anywhere on the radar!
          </div>
        </div>

        <!-- Controls for Tab 1 -->
        <div class="bg-slate-900/70 p-4 rounded-xl border border-slate-800 flex flex-col sm:flex-row gap-4 justify-between items-center text-xs">
          <div class="flex items-center gap-2 flex-wrap">
            <button id="toggle-grid-type" onclick="toggleBasicsGrid()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-200 border border-slate-700 transition">
