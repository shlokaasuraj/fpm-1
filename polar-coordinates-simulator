            </label>
          </div>

          <!-- Dynamic parameter sliders -->
          <div id="curve-sliders-container" class="flex items-center gap-3"></div>
        </div>
      </div>

      <!-- Right Explanation Column -->
      <div class="lg:w-5/12 flex flex-col gap-4">
        <div class="bg-gradient-to-br from-cyan-950/40 via-slate-900 to-slate-900 p-5 rounded-2xl border border-cyan-500/30">
          <div class="flex items-center gap-2 mb-2">
            <span id="curve-story-icon" class="text-2xl">❤️</span>
